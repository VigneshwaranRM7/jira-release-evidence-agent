# Jira Cloud Credentials (Required for live Jira Cloud mode)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=user@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=REL

# LLM Credentials (Optional: used for generative agent explanations; fallback rule engine is enabled by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o

# Execution Environment
ENVIRONMENT=development
USE_MOCK_JIRA=true
DEFAULT_DATASET_LABEL=tyn-release-assessment-v2

